   "source": [
    "n = int(input(\"enter the number: \"))\n",
    "count = 0\n",
    "for i in range(2, n):\n",
    "        if n % i == 0:\n",
    "            print(i)\n",
    "            count = count + 1\n",
    "            break\n",
    "if count == 0: \n",
    "     print(\"Prime\")\n",
    "else:\n",
    "        print(\" not Prime\")"
   ]
